# Copy this file to .env.local and fill with your local secrets.
# Put .env.local in .gitignore to avoid committing secrets.

# Database connection (example):
# DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/monetized_accounts
# DIRECT_URL=postgresql://postgres:your_db_password@localhost:5432/monetized_accounts

# Application port
PORT=5000

# JWT secret used to sign tokens
# JWT_SECRET=your_jwt_secret_here

# Supabase Storage for persistent site assets
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Google OAuth client IDs
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Admin account password for local seed or scripts (optional)
# ADMIN_PASSWORD=your_admin_password_here
# ADMIN_TEST_PASSWORD=your_admin_test_password_here
